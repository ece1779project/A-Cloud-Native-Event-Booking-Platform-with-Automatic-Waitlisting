API_PORT=8000
WS_PORT=8001
FRONTEND_PORT=5173
WORKER_METRICS_PORT=9100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Change this for any non-throwaway local environment.
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_DB=event_booking
POSTGRES_USER=booking
# Set a local password using URL-safe characters before starting Compose.
POSTGRES_PASSWORD=

ENVIRONMENT=local
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173

HOLD_VALIDITY_SECONDS=300
OFFER_VALIDITY_SECONDS=600
REGISTRATION_WRITE_LIMIT_PER_MINUTE=30
LOGIN_LIMIT_PER_MINUTE=10
TRUSTED_PROXY_CIDRS=

JWT_ISSUER=seatflow
JWT_AUDIENCE=seatflow-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

WORKER_SCAN_INTERVAL_SECONDS=1
WORKER_SCAN_BATCH_SIZE=100

# Compose builds DATABASE_URL for its containers from the values above.
# Set it here only to run the app or Alembic on the host (`uv run alembic ...`),
# pointing at a PostgreSQL that the host can reach.
# DATABASE_URL=postgresql+asyncpg://booking:<password>@127.0.0.1:5432/event_booking

# Ed25519 keys for access tokens (API only). Generate a local pair as in tutorial 02;
# multi-line PEM values must be wrapped in double quotes. Never commit real values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Compose passes this file to the API and the worker. Both create offers, so they
# share OFFER_VALIDITY_SECONDS. Uncomment short values for a demo; the defaults are shown.
# HOLD_VALIDITY_SECONDS=300
# OFFER_VALIDITY_SECONDS=600
# WORKER_SCAN_INTERVAL_SECONDS=1
# WORKER_SCAN_BATCH_SIZE=100

# First administrator, read only by `python -m app.cli.bootstrap_admin`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
